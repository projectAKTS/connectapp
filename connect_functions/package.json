{
  "name": "connect_functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "deploy": "firebase deploy --only functions",
    "test:call-v2": "node --test test/call_v2/*.test.js",
    "test:call-v2:rules": "firebase --project demo-helperly-call-v2-rules --config ../firebase.json emulators:exec --only firestore \"node --test test/call_v2/firestore_rules_v2.test.js\"",
    "test:call-v2:emulator": "firebase --project demo-helperly-call-v2 --config ../firebase.json emulators:exec --only firestore \"npm run test:call-v2\"",
    "check:call-v2": "node --check call_v2/*.js && node --check test/call_v2/*.js",
    "validate:call-v2:deployment": "node call_v2/validate_deployment_v2.js",
    "preflight:call-v2": "node call_v2/preflight_call_v2.js"
  },
  "dependencies": {
    "@google-cloud/tasks": "^6.2.3",
    "agora-token": "^2.0.3",
    "apn": "2.2.0",
    "firebase-admin": "12.7.0",
    "firebase-functions": "5.1.1",
    "google-auth-library": "^10.9.0",
    "stripe": "18.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1"
  }
}
