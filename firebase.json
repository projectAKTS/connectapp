{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "connect_functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "regex": "^/privacy/?$", "destination": "/privacy.html" },
      { "regex": "^/terms/?$", "destination": "/terms.html" },
      { "regex": "^/(support|safety|community-guidelines)/?$", "destination": "/safety.html" },
      { "regex": "^/delete-account/?$", "destination": "/delete-account.html" },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
