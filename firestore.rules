rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isConnectionParticipant(data) {
      return isSignedIn() && (
        (data.keys().hasAny(['users']) &&
          data.users is list &&
          data.users.hasAny([request.auth.uid])) ||
        (data.keys().hasAny(['userId']) &&
          data.userId is string &&
          data.userId == request.auth.uid) ||
        (data.keys().hasAny(['connectedUserId']) &&
          data.connectedUserId is string &&
          data.connectedUserId == request.auth.uid)
      );
    }

    function isV2Call(data) {
      return data.keys().hasAny(['callSystem']) &&
        data.callSystem == "v2";
    }

    function hasExactV2Participants(data) {
      return data.keys().hasAll(['callerUid', 'calleeUid', 'participantUids']) &&
        data.callerUid is string &&
        data.calleeUid is string &&
        data.participantUids is list &&
        data.participantUids.size() == 2 &&
        data.participantUids.hasAll([data.callerUid, data.calleeUid]);
    }

    function isV2CallParticipant(data, uid) {
      return isV2Call(data) &&
        hasExactV2Participants(data) &&
        data.participantUids.hasAny([uid]);
    }

    function canReadV2Call(data) {
      return isSignedIn() &&
        isV2CallParticipant(data, request.auth.uid);
    }

    function canReadV2Participant(callId, participantUid) {
      let call = get(/databases/$(database)/documents/calls/$(callId)).data;
      return isSignedIn() &&
        isV2CallParticipant(call, request.auth.uid) &&
        isV2CallParticipant(call, participantUid);
    }
    
    // ✅ Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // ✅ Posts Collection
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userID;
      
      // — Editing content/tags/timestamp (by owner)
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userID
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content', 'timestamp', 'tags',
          'imageUrl', 'imageUrls',
          'videoUrl', 'videoThumbUrl',
          'mediaAspectRatio',
          'mediaUploadStatus', 'mediaUploadUpdatedAt', 'mediaUploadStartedAt',
          'mediaCount', 'hasVideo'
        ]);
      
      // — Like/Unlike (no self-likes)
      allow update: if request.auth != null
        && request.auth.uid != resource.data.userID
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likedBy'
        ]);
      
      // — Report post
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports']);
      
      // — Boost (admins only)
      allow update: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isBoosted', 'boostExpiresAt'
        ]);
      
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userID;
      
      // 🚀 Helpful-marks subcollection (one per user, no self-helpful)
      match /helpfuls/{helperId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == helperId
          && get(/databases/$(database)/documents/posts/$(postId))
               .data.userID != helperId;
        allow delete: if request.auth != null
          && request.auth.uid == helperId;
      }
    }
    
    // ✅ Comments
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userID
        && request.resource.data.keys().hasOnly([
          'content', 'timestamp'
        ]);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userID;
    }
    
    // ✅ Replies
    match /posts/{postId}/comments/{commentId}/replies/{replyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userID
        && request.resource.data.keys().hasOnly([
          'content', 'timestamp'
        ]);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userID;
    }
    
    // ✅ Followers
    match /followers/{userId}/userFollowers/{followerId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.uid == followerId;
      allow update: if false;
    }
    
    // ✅ Reports
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }

    // ✅ Call invites
    match /callInvites/{inviteId} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow update, delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }

    // Helperly Call System V2 public read boundary.
    // V2 writes are Admin SDK only; media and heartbeat changes must go
    // through guarded callable functions.
    match /calls/{callId} {
      allow read: if canReadV2Call(resource.data);
      allow create, update, delete: if false;

      match /participants/{participantUid} {
        allow read: if canReadV2Participant(callId, participantUid);
        allow create, update, delete: if false;
      }
    }

    // Helperly Call System V2 private operational data. These documents
    // contain lock claims, fencing tokens, commands, idempotency records,
    // dispatch state, execution state, and diagnostics.
    match /callOps/{callId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /activeCallLocks/{uid} {
      allow read, write: if false;
    }

    match /callCommandKeys/{key} {
      allow read, write: if false;
    }

    // ✅ Chats
    match /chats/{chatId} {
      allow create: if isSignedIn() && (
        (request.resource.data.keys().hasAny(['participants']) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.hasAny([request.auth.uid])) ||
        (request.resource.data.keys().hasAny(['users']) &&
          request.resource.data.users is list &&
          request.resource.data.users.hasAny([request.auth.uid]))
      );

      allow read: if isSignedIn() && (
        (resource.data.keys().hasAny(['participants']) &&
          resource.data.participants is list &&
          resource.data.participants.hasAny([request.auth.uid])) ||
        (resource.data.keys().hasAny(['users']) &&
          resource.data.users is list &&
          resource.data.users.hasAny([request.auth.uid]))
      );

      // Allow migration updates for legacy chat docs by checking either
      // current data OR the incoming updated data.
      allow update: if isSignedIn() && (
        (resource.data.keys().hasAny(['participants']) &&
          resource.data.participants is list &&
          resource.data.participants.hasAny([request.auth.uid])) ||
        (resource.data.keys().hasAny(['users']) &&
          resource.data.users is list &&
          resource.data.users.hasAny([request.auth.uid])) ||
        (request.resource.data.keys().hasAny(['participants']) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.hasAny([request.auth.uid])) ||
        (request.resource.data.keys().hasAny(['users']) &&
          request.resource.data.users is list &&
          request.resource.data.users.hasAny([request.auth.uid]))
      );

      allow delete: if isSignedIn() && (
        (resource.data.keys().hasAny(['participants']) &&
          resource.data.participants is list &&
          resource.data.participants.hasAny([request.auth.uid])) ||
        (resource.data.keys().hasAny(['users']) &&
          resource.data.users is list &&
          resource.data.users.hasAny([request.auth.uid]))
      );

      // ✅ Chat messages
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['participants']) &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid])) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['users']) &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.users is list &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]))
        );

        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && (
            (get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['participants']) &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid])) ||
            (get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['users']) &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.users is list &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]))
          );

        allow update, delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
      }
    }

    // ✅ Connections (both schemas supported)
    match /connections/{connectionId} {
      allow create: if isConnectionParticipant(request.resource.data);
      allow read: if isConnectionParticipant(resource.data);
      // Allow legacy connection docs to be migrated by accepting updates
      // when the user is participant in either current OR incoming data.
      allow update: if isConnectionParticipant(resource.data)
        || isConnectionParticipant(request.resource.data);
      allow delete: if isConnectionParticipant(resource.data);
    }
    
    // ✅ Consultations
    match /consultations/{consultationId} {
      allow create, read: if request.auth != null;
    }
  }
}
