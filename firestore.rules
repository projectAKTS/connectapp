rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ✅ Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // ✅ Posts Collection
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userID;
      
      // — Editing content/tags/timestamp (by owner)
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userID
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content', 'timestamp', 'tags',
          'imageUrl', 'imageUrls',
          'videoUrl', 'videoThumbUrl',
          'mediaAspectRatio',
          'mediaUploadStatus', 'mediaUploadUpdatedAt', 'mediaUploadStartedAt',
          'mediaCount', 'hasVideo'
        ]);
      
      // — Like/Unlike (no self-likes)
      allow update: if request.auth != null
        && request.auth.uid != resource.data.userID
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likedBy'
        ]);
      
      // — Report post
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports']);
      
      // — Boost (admins only)
      allow update: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isBoosted', 'boostExpiresAt'
        ]);
      
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userID;
      
      // 🚀 Helpful-marks subcollection (one per user, no self-helpful)
      match /helpfuls/{helperId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == helperId
          && get(/databases/$(database)/documents/posts/$(postId))
               .data.userID != helperId;
        allow delete: if request.auth != null
          && request.auth.uid == helperId;
      }
    }
    
    // ✅ Comments
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userID
        && request.resource.data.keys().hasOnly([
          'content', 'timestamp'
        ]);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userID;
    }
    
    // ✅ Replies
    match /posts/{postId}/comments/{commentId}/replies/{replyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userID
        && request.resource.data.keys().hasOnly([
          'content', 'timestamp'
        ]);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userID;
    }
    
    // ✅ Followers
    match /followers/{userId}/userFollowers/{followerId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.uid == followerId;
      allow update: if false;
    }
    
    // ✅ Reports
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }
    
    // ✅ Consultations
    match /consultations/{consultationId} {
      allow create, read: if request.auth != null;
    }
  }
}
