rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isConnectionParticipant(data) {
      return isSignedIn() && (
        (data.keys().hasAny(['users']) &&
          data.users is list &&
          data.users.hasAny([request.auth.uid])) ||
        (data.keys().hasAny(['userId']) &&
          data.userId is string &&
          data.userId == request.auth.uid) ||
        (data.keys().hasAny(['connectedUserId']) &&
          data.connectedUserId is string &&
          data.connectedUserId == request.auth.uid)
      );
    }

    function isV2Call(data) {
      return data.keys().hasAny(['callSystem']) &&
        data.callSystem == "v2";
    }

    function hasExactV2Participants(data) {
      return data.keys().hasAll(['callerUid', 'calleeUid', 'participantUids']) &&
        data.callerUid is string &&
        data.calleeUid is string &&
        data.callerUid != data.calleeUid &&
        data.participantUids is list &&
        data.participantUids.size() == 2 &&
        data.participantUids.hasAll([data.callerUid, data.calleeUid]);
    }

    function isV2CallParticipant(data, uid) {
      return isV2Call(data) &&
        hasExactV2Participants(data) &&
        data.participantUids.hasAny([uid]);
    }

    function canReadV2Call(data) {
      return isSignedIn() &&
        isV2CallParticipant(data, request.auth.uid);
    }

    function canReadV2Participant(callId, participantUid) {
      let call = get(/databases/$(database)/documents/calls/$(callId)).data;
      return isSignedIn() &&
        isV2CallParticipant(call, request.auth.uid) &&
        isV2CallParticipant(call, participantUid);
    }

    // Fields only the server (Admin SDK) may set on a user doc: trust and
    // payment state a user must not grant themselves.
    function protectedUserFields() {
      return [
        'isVerified',
        'verifiedAt',
        'verification',
        'isAdmin',
        'stripeCustomerId',
        'stripeAccountId',
        'rating',
        'ratingCount',
        'ratingSum',
        'reviewCount'
      ];
    }

    // The other side of a two-person chat has not blocked the sender.
    function notBlockedInChat(chat) {
      let people = chat.keys().hasAny(['participants'])
        ? chat.participants
        : (chat.keys().hasAny(['users']) ? chat.users : []);
      let others = people.removeAll([request.auth.uid]);
      return others.size() != 1 ||
        !get(/databases/$(database)/documents/users/$(others[0]))
          .data.get('blockedUids', []).hasAny([request.auth.uid]);
    }

    // ---- 18+ policy (server-side; see lib/models/age_policy.dart) ----
    // Everyone, including accounts created before the policy, must have
    // declared 'adult' before posting, commenting, messaging, calling,
    // connecting, booking or reviewing. Accounts without a declaration are
    // not locked out: they can sign in, edit their profile, declare (new
    // app builds) and delete the account. Old builds cannot declare, so
    // they cannot bypass it. Declared minors stay restricted.
    function ageAllowedFor(userData) {
      return userData.get('ageDeclaration', '') == 'adult';
    }

    // A user doc always exists (onAuthUserCreated creates it at sign-up and
    // users cannot delete it); a missing one is only a sign-up race.
    function callerAgeAllowed() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(path) || ageAllowedFor(get(path).data);
    }

    function notRestrictedMinor(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return !exists(path) || get(path).data.get('ageDeclaration', '') != 'minor';
    }

    // The other person in a two-person chat is not a restricted minor.
    function otherNotMinorInChat(chat) {
      let people = chat.keys().hasAny(['participants'])
        ? chat.participants
        : (chat.keys().hasAny(['users']) ? chat.users : []);
      let others = people.removeAll([request.auth.uid]);
      return others.size() != 1 || notRestrictedMinor(others[0]);
    }

    // ---- First contact (docs/SAFETY_ROADMAP.md #3) ----
    // `repliedBy` lists who has written in a chat. Only the server sets it
    // (onChatMessageCreated; existing chats by tool/backfill_replied_by.mjs).
    // Until the other person has written, you can send text only, and you
    // can call them only if they are a helper.
    function otherHasWritten(chat) {
      let people = chat.keys().hasAny(['participants'])
        ? chat.participants
        : (chat.keys().hasAny(['users']) ? chat.users : []);
      let others = people.removeAll([request.auth.uid]);
      return chat.get('repliedBy', []).hasAny(others);
    }

    function isPlainTextMessage(msg) {
      return msg.get('type', 'text') == 'text' &&
        !msg.get('text', '').lower().matches('(?s).*(https?://|www[.]).*');
    }

    function isContactableHelper(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) && (
        get(path).data.get('role', '') in ['helper', 'both'] ||
        get(path).data.get('isHelper', false) == true);
    }

    function hasWrittenInChat(chatPath, uid) {
      return exists(chatPath) &&
        get(chatPath).data.get('repliedBy', []).hasAny([uid]);
    }

    function calleeAcceptsCall(from, to) {
      return isContactableHelper(to) ||
        hasWrittenInChat(/databases/$(database)/documents/chats/$(from + '_' + to), to) ||
        hasWrittenInChat(/databases/$(database)/documents/chats/$(to + '_' + from), to);
    }

    function optionalString(data, key) {
      return !(data.keys().hasAny([key])) || data[key] is string;
    }

    function validPushInstallationData(userId, installationId) {
      return request.resource.data.keys().hasOnly([
          'installationId',
          'ownerUid',
          'active',
          'platform',
          'fcmToken',
          'apnsToken',
          'voipToken',
          'answeredElsewhereV1',
          'lastSeenAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'installationId',
          'ownerUid',
          'active',
          'platform'
        ]) &&
        request.resource.data.installationId is string &&
        request.resource.data.installationId == installationId &&
        request.resource.data.ownerUid is string &&
        request.resource.data.ownerUid == userId &&
        request.resource.data.active is bool &&
        request.resource.data.platform is string &&
        (
          request.resource.data.platform == 'ios' ||
          request.resource.data.platform == 'android' ||
          request.resource.data.platform == 'other'
        ) &&
        optionalString(request.resource.data, 'fcmToken') &&
        optionalString(request.resource.data, 'apnsToken') &&
        optionalString(request.resource.data, 'voipToken') &&
        (
          !(request.resource.data.keys().hasAny(['answeredElsewhereV1'])) ||
          request.resource.data.answeredElsewhereV1 is bool
        );
    }
    
    // ✅ Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(protectedUserFields());
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(protectedUserFields())
        && keepsMinorRestriction();
      allow delete: if false;

      // The owner's private safety settings (posts they reported and hid).
      // Other private docs (for example the account email) stay server-only.
      match /private/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && docId == 'safety';
      }

      // 18+ policy: a self-declared minor stays restricted. Only an
      // operator (console / Admin SDK) can lift it after review.
      function keepsMinorRestriction() {
        return resource.data.get('ageDeclaration', '') != 'minor'
          || request.resource.data.get('ageDeclaration', '') == 'minor';
      }

      match /pushInstallations/{installationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && validPushInstallationData(userId, installationId);
        allow delete: if false;
      }
    }
    
    // ✅ Posts Collection
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userID
        && callerAgeAllowed();
      
      // — Editing content/tags/timestamp (by owner)
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userID
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content', 'timestamp', 'tags',
          'imageUrl', 'imageUrls',
          'videoUrl', 'videoThumbUrl',
          'mediaAspectRatio',
          'mediaUploadStatus', 'mediaUploadUpdatedAt', 'mediaUploadStartedAt',
          'mediaCount', 'hasVideo'
        ]);
      
      // — Like/Unlike (no self-likes). A like adds only your own uid and
      // raises the count by one; an unlike removes only your own uid and
      // lowers it by one. Nobody can change other people's likes.
      allow update: if request.auth != null
        && request.auth.uid != resource.data.userID
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likedBy'
        ])
        && ownLikeChange();

      // Reports go to the private `reports` collection (see below); the old
      // `reports` field on a post is no longer writable.
      
      // — Boost (admins only)
      allow update: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isBoosted', 'boostExpiresAt'
        ]);
      
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userID;
      
      function ownLikeChange() {
        let before = resource.data.get('likedBy', []).toSet();
        let after = request.resource.data.get('likedBy', []).toSet();
        let me = [request.auth.uid].toSet();
        let oldCount = resource.data.get('likes', 0);
        return request.resource.data.likes is int && (
          (after.difference(before) == me && before.difference(after).size() == 0
            && request.resource.data.likes == oldCount + 1) ||
          (before.difference(after) == me && after.difference(before).size() == 0
            && request.resource.data.likes == oldCount - 1)
        );
      }

      // 🚀 Helpful-marks subcollection (one per user, no self-helpful)
      match /helpfuls/{helperId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == helperId
          && get(/databases/$(database)/documents/posts/$(postId))
               .data.userID != helperId;
        allow delete: if request.auth != null
          && request.auth.uid == helperId;
      }
    }
    
    // ✅ Comments
    // Written as yourself only; the server adds `countedAt`. The commenter
    // or the post's author can delete a comment.
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && callerAgeAllowed()
        && request.resource.data.userID == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userID', 'authorName', 'authorAvatar', 'text', 'timestamp'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.timestamp == request.time;
      allow update: if false;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.get('userID', '')
          || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userID);
    }
    
    // ✅ Replies
    match /posts/{postId}/comments/{commentId}/replies/{replyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && callerAgeAllowed()
        && request.resource.data.userID == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userID
        && request.resource.data.keys().hasOnly([
          'content', 'timestamp'
        ]);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userID;
    }
    
    // ✅ Followers
    match /followers/{userId}/userFollowers/{followerId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.uid == followerId;
      allow update: if false;
    }
    
    // ✅ Reports
    // Reports are private: reporters create them, only moderators (Admin
    // SDK) read them.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ✅ Call invites
    match /callInvites/{inviteId} {
      // New calls only between people allowed by the 18+ policy; ending or
      // declining existing calls (update) is unaffected.
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && callerAgeAllowed()
        && notRestrictedMinor(request.resource.data.toUid)
        && calleeAcceptsCall(request.auth.uid, request.resource.data.toUid);
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow update, delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }

    // Helperly Call System V2 public read boundary.
    // V2 writes are Admin SDK only; media and heartbeat changes must go
    // through guarded callable functions.
    match /calls/{callId} {
      allow read: if canReadV2Call(resource.data);
      allow create, update, delete: if false;

      match /participants/{participantUid} {
        allow read: if canReadV2Participant(callId, participantUid);
        allow create, update, delete: if false;
      }
    }

    // Helperly Call System V2 private operational data. These documents
    // contain lock claims, fencing tokens, commands, idempotency records,
    // dispatch state, execution state, and diagnostics.
    // Payment attempts (one per booking operation). Written and read only
    // by Cloud Functions; clients never see or change them.
    match /paymentOperations/{operationId} {
      allow read, write: if false;
    }

    // Unfinished account deletions (retried by the daily job). Server only.
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }

    match /callOps/{callId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /activeCallLocks/{uid} {
      allow read, write: if false;
    }

    match /callCommandKeys/{key} {
      allow read, write: if false;
    }

    // ✅ Chats
    match /chats/{chatId} {
      allow create: if isSignedIn()
        && !request.resource.data.keys().hasAny(['repliedBy']) && (
        (request.resource.data.keys().hasAny(['participants']) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.hasAny([request.auth.uid])) ||
        (request.resource.data.keys().hasAny(['users']) &&
          request.resource.data.users is list &&
          request.resource.data.users.hasAny([request.auth.uid]))
      );

      // A chat that does not exist yet may be read (as "missing") by a
      // person whose uid is in its id ("uidA_uidB"), so opening a first
      // conversation can check for it before creating it. Only for get:
      // list queries must stay provable from their array-contains filter.
      allow get: if isSignedIn() && (
        (resource == null && chatId.split('_').hasAny([request.auth.uid])) ||
        (resource != null && resource.data.keys().hasAny(['participants']) &&
          resource.data.participants is list &&
          resource.data.participants.hasAny([request.auth.uid])) ||
        (resource != null && resource.data.keys().hasAny(['users']) &&
          resource.data.users is list &&
          resource.data.users.hasAny([request.auth.uid]))
      );

      // Written so an array-contains filter on either field proves it.
      allow list: if isSignedIn() && (
        resource.data.participants.hasAny([request.auth.uid]) ||
        resource.data.users.hasAny([request.auth.uid])
      );

      // Only the people already in a chat may change it. A legacy chat doc
      // that lacks its participant lists may be repaired, but only by a
      // person whose uid is in the chat id ("uidA_uidB"): a stranger cannot
      // write themselves into someone else's chat. `repliedBy` is server-only.
      allow update: if isSignedIn()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['repliedBy']) && (
        (resource.data.keys().hasAny(['participants']) &&
          resource.data.participants is list &&
          resource.data.participants.hasAny([request.auth.uid])) ||
        (resource.data.keys().hasAny(['users']) &&
          resource.data.users is list &&
          resource.data.users.hasAny([request.auth.uid])) ||
        (chatId.split('_').hasAny([request.auth.uid]) && (
          (request.resource.data.keys().hasAny(['participants']) &&
            request.resource.data.participants is list &&
            request.resource.data.participants.hasAny([request.auth.uid])) ||
          (request.resource.data.keys().hasAny(['users']) &&
            request.resource.data.users is list &&
            request.resource.data.users.hasAny([request.auth.uid]))
        ))
      );

      allow delete: if isSignedIn() && (
        (resource.data.keys().hasAny(['participants']) &&
          resource.data.participants is list &&
          resource.data.participants.hasAny([request.auth.uid])) ||
        (resource.data.keys().hasAny(['users']) &&
          resource.data.users is list &&
          resource.data.users.hasAny([request.auth.uid]))
      );

      // ✅ Chat messages
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['participants']) &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid])) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['users']) &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.users is list &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]))
        );

        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          // Set by the server when it notifies; a client must not pre-set it.
          && !request.resource.data.keys().hasAny(['notifiedAt'])
          && callerAgeAllowed()
          && otherNotMinorInChat(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && notBlockedInChat(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && (isPlainTextMessage(request.resource.data) ||
            otherHasWritten(get(/databases/$(database)/documents/chats/$(chatId)).data))
          && (
            (get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['participants']) &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid])) ||
            (get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['users']) &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.users is list &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.users.hasAny([request.auth.uid]))
          );

        allow update, delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
      }
    }

    // ✅ Connections (both schemas supported)
    match /connections/{connectionId} {
      allow create: if isConnectionParticipant(request.resource.data)
        && callerAgeAllowed();
      allow get: if isConnectionParticipant(resource.data);
      // Written so the app's filters (users array-contains, userId ==,
      // connectedUserId ==) prove it.
      allow list: if isSignedIn() && (
        resource.data.users.hasAny([request.auth.uid]) ||
        resource.data.userId == request.auth.uid ||
        resource.data.connectedUserId == request.auth.uid
      );
      // Only the two people in a connection may change it. A legacy doc
      // without participant fields may be repaired, but only by a person
      // whose uid is in its id ("uidA_uidB").
      allow update: if isConnectionParticipant(resource.data)
        || (connectionId.split('_').hasAny([request.auth.uid])
          && isConnectionParticipant(request.resource.data));
      allow delete: if isConnectionParticipant(resource.data);
    }
    
    // ✅ Consultations
    // Consultations: only the two participants; the payer creates it.
    match /consultations/{consultationId} {
      // No `is list` check: a list query cannot prove it, and hasAny on a
      // non-list is an error, which denies anyway.
      allow read: if isSignedIn()
        && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.hasAny([request.auth.uid])
        && callerAgeAllowed();
    }

    // Reviews: the payer rates a consultation once, after its start time and
    // unless it was cancelled. The doc id is the consultation id, so a second
    // review is an update, which is denied. The server adds `countedAt` when
    // it updates the helper's average.
    match /reviews/{consultationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
          ['consultationId', 'reviewerUid', 'helperUid', 'stars', 'text', 'createdAt'])
        && request.resource.data.consultationId == consultationId
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.helperUid is string
        && request.resource.data.helperUid != request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.get('text', '') is string
        && request.resource.data.get('text', '').size() <= 500
        && request.resource.data.createdAt == request.time
        && reviewableConsultation(consultationId, request.resource.data.helperUid)
        && callerAgeAllowed();
      allow update, delete: if false;
    }

    function reviewableConsultation(consultationId, helperUid) {
      let c = get(/databases/$(database)/documents/consultations/$(consultationId)).data;
      return c.userId == request.auth.uid
        && c.targetUserId == helperUid
        && c.get('status', 'scheduled') != 'cancelled'
        && c.scheduledAt is timestamp
        && c.scheduledAt < request.time;
    }
  }
}
